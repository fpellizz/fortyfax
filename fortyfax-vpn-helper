#!/bin/bash
# Helper script for fortyfax - runs as root via pkexec.
# Usage:
#   fortyfax-vpn-helper start openfortivpn [args...]
#   fortyfax-vpn-helper start gpclient [args...]
#   fortyfax-vpn-helper stop <PID>
#   fortyfax-vpn-helper kill <PID>
#   fortyfax-vpn-helper dns <interface> <args...>
set -euo pipefail

ACTION="${1:-}"
shift || true

case "$ACTION" in
    start)
        BACKEND="${1:-}"
        shift || true
        case "$BACKEND" in
            openfortivpn)
                exec openfortivpn "$@"
                ;;
            gpclient)
                # Before starting a new gpclient session, cleanup any stale
                # instance (from a previous crashed run). Done inline in the
                # same pkexec call to avoid an extra password prompt.
                # Skip cleanup for subcommands that don't start a new tunnel.
                if [[ "${1:-}" != "disconnect" && "${1:-}" != "launch-gui" ]]; then
                    gpclient disconnect 2>/dev/null || true
                    # NOTE: -x (exact comm match), NOT -f: with -f the pattern
                    # would match this helper's own command line
                    # ("... start gpclient connect ...") and SIGTERM ourselves.
                    pkill -x gpclient 2>/dev/null || true
                    pkill -x openconnect 2>/dev/null || true
                    # Give processes a moment to exit
                    sleep 0.3
                fi
                exec gpclient "$@"
                ;;
            *)
                echo "Usage: fortyfax-vpn-helper start {openfortivpn|gpclient} [args...]" >&2
                exit 1
                ;;
        esac
        ;;
    stop)
        PID="${1:-}"
        if [[ -z "$PID" ]]; then
            echo "Usage: fortyfax-vpn-helper stop <PID>" >&2
            exit 1
        fi
        # Verify it's a VPN process (openfortivpn or gpclient)
        if [[ -f "/proc/$PID/comm" ]]; then
            COMM="$(cat "/proc/$PID/comm")"
            if [[ "$COMM" == "openfortivpn" || "$COMM" == "gpclient" || "$COMM" == "openconnect" ]]; then
                kill -SIGTERM "$PID"
            else
                echo "PID $PID is not a VPN process (comm=$COMM)" >&2
                exit 1
            fi
        else
            echo "PID $PID does not exist" >&2
            exit 1
        fi
        ;;
    kill)
        PID="${1:-}"
        if [[ -z "$PID" ]]; then
            echo "Usage: fortyfax-vpn-helper kill <PID>" >&2
            exit 1
        fi
        if [[ -f "/proc/$PID/comm" ]]; then
            COMM="$(cat "/proc/$PID/comm")"
            if [[ "$COMM" == "openfortivpn" || "$COMM" == "gpclient" || "$COMM" == "openconnect" ]]; then
                kill -9 "$PID"
            else
                echo "PID $PID is not a VPN process (comm=$COMM)" >&2
                exit 1
            fi
        else
            echo "PID $PID does not exist" >&2
            exit 1
        fi
        ;;
    dns)
        # DNS fix helper: runs resolvectl/ip commands as root
        exec "$@"
        ;;
    cleanup-gp)
        # Cleanup stale GlobalProtect state in a single pkexec call.
        # Runs: gpclient disconnect + pkill gpclient + pkill openconnect
        # Exit 0 always (cleanup is best-effort).
        gpclient disconnect 2>/dev/null || true
        pkill -x gpclient 2>/dev/null || true
        pkill -x openconnect 2>/dev/null || true
        # Also cleanup temp wrapper files
        rm -f /tmp/fortyfax_browser_wrapper.sh /tmp/fortyfax_vpnc_wrapper.sh 2>/dev/null || true
        exit 0
        ;;
    *)
        echo "Usage: fortyfax-vpn-helper {start|stop|kill|dns|cleanup-gp} [args...]" >&2
        exit 1
        ;;
esac
